# Environment Variables Configuration
# NEVER commit actual secrets, service role keys, or production passwords to version control.

# Google Gemini API Key (Server-Side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Master Administrator Credentials & Security Tokens (Server-Side only)
# In production, these MUST be set to strong, high-entropy secrets.
ADMIN_EMAIL=samriddhibroom@gmail.com
ADMIN_PASSWORD=Kumar@1987
ADMIN_PIN=1987
ADMIN_JWT_SECRET=your_high_entropy_256_bit_jwt_secret_here

# Redis Connection URL (Optional - for multi-instance distributed rate limiting)
# REDIS_URL=redis://username:password@redis-host:6379

# Supabase Configuration
# VITE_ prefixed keys are client-safe publishable keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Optional Supabase Service Role Key (Server-Side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=https://yourdomain.com

